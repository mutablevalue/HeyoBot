{
  "name": "my-discord-bot",
  "version": "1.0.0",
  "description": "Scalable Discord bot in TypeScript with a queue system and modular commands",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "npm run build && node dist/index.js",
    "dev": "ts-node-dev --respawn src/index.ts"
  },
  "dependencies": {
    "discord.js": "^14.0.0",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/js-yaml": "^4.0.1",
    "typescript": "^5.0.0",
    "ts-node-dev": "^2.0.0"
  }
}